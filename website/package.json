  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
